# Public URL of the site (canonical, hreflang, sitemap, Open Graph)
SITE_URL=https://auditcockpits.com

# Resend (demo request form -> email)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Verified sender; defaults to Resend's sandbox address if unset
RESEND_FROM_EMAIL=ARS <onboarding@resend.dev>
# Where demo request submissions are delivered
DEMO_REQUEST_TO_EMAIL=you@example.com

# Content flags
# Brazilian public tender text on the Home (needs legal review before enabling)
FEATURE_LICITACOES=false

# Postgres (ISO Radar, newsletter, admin login). Migrations run on `pnpm start`.
DATABASE_URL=postgres://user:password@host:5432/db

# ISO Radar drafts (Claude API)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# /admin: who may sign in (magic link by e-mail) and the cookie signing secret (32+ chars)
ADMIN_EMAILS=you@example.com
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string-of-32-plus-chars

# Bearer token the Railway cron services send to /api/cron/radar/ and /api/cron/newsletter/
CRON_SECRET=change-me

# Sender for the newsletter, kept apart from product/admin e-mails (defaults to RESEND_FROM_EMAIL)
NEWSLETTER_FROM_EMAIL=ISO Radar <radar@auditcockpits.com>
